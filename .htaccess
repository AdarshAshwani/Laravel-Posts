# public_html/dailylogs/.htaccess
<IfModule mod_rewrite.c>
    Options -MultiViews -Indexes
    RewriteEngine On
    RewriteBase /story/

    # Serve files that actually exist
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Map common public assets without exposing /public
    RewriteRule ^(favicon\.ico|robots\.txt)$ public/$1 [L,NC]
    RewriteRule ^(build|assets|css|js|images|img|fonts|vendor|storage)/(.*)$ public/$1/$2 [L,NC]

    # Everything else -> our local index.php (shim)
    RewriteRule ^ index.php [L]
</IfModule>

# Block sensitive files if guessed directly
<FilesMatch "^(\.env|artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|webpack\.mix\.js|vite\.config\.js|server\.php)$">
  Require all denied
</FilesMatch>
